# Copie este arquivo para ".env" (uso local) ou cadastre as variáveis no painel da Vercel.
# O arquivo ".env" NÃO vai para o GitHub.

# Chave da API da Anthropic (necessária só para ler PRINT; PDF funciona sem ela)
ANTHROPIC_API_KEY=

# Opcionais
ANTHROPIC_MODEL=claude-sonnet-5-5
RATE_LIMIT_PER_HOUR=20
